{
  "$schema": "../../../docs/unma-extension-v1.schema.json",
  "schema_version": 1,
  "mod_id": "ExampleProvider",
  "alarms": [
    {
      "id": "storage-low",
      "prototype_ids": [
        "ExampleProvider_StorageT1",
        "ExampleProvider_StorageT2"
      ],
      "scope": "aggregate",
      "panel_id": "supply",
      "localization_namespace": "ExampleProvider",
      "message_key": "multilanglib.ExampleProvider.alarm.storage_low",
      "message_fallback": "LAGERVORRAT NIEDRIG",
      "detail_key": "multilanglib.ExampleProvider.alarm.storage_low.detail",
      "detail_fallback": "Mindestens ein Lager liegt unter 15 Prozent.",
      "severity": "warning",
      "sound_id": "bell",
      "active_color": "#F0C541",
      "auto_acknowledge_on_clear": false,
      "logic": "all",
      "conditions": [
        {
          "metric": "$stored.quantity",
          "label_key": "multilanglib.ExampleProvider.metric.storage_fill",
          "label_fallback": "Lagerfüllstand",
          "operator": "<=",
          "threshold": 15,
          "value_mode": "percent_of_reference",
          "reference_metric": "$stored.capacity",
          "reference_label_key": "multilanglib.ExampleProvider.metric.storage_capacity",
          "reference_label_fallback": "Lagerkapazität"
        }
      ]
    },
    {
      "id": "tank-pressure-high",
      "prototype_ids": [
        "ExampleProvider_PressureTank"
      ],
      "scope": "per_entity",
      "panel_id": "main",
      "localization_namespace": "ExampleProvider",
      "message_key": "multilanglib.ExampleProvider.alarm.tank_pressure_high",
      "message_fallback": "TANKDRUCK HOCH",
      "detail_key": "multilanglib.ExampleProvider.alarm.tank_pressure_high.detail",
      "detail_fallback": "Der Tankdruck liegt über 90 Prozent.",
      "severity": "critical",
      "sound_id": "horn",
      "active_color": "#F05A32",
      "auto_acknowledge_on_clear": false,
      "logic": "all",
      "conditions": [
        {
          "metric": "example.pressure_percent",
          "label_key": "multilanglib.ExampleProvider.metric.pressure_percent",
          "label_fallback": "Tankdruck",
          "operator": ">=",
          "threshold": 90,
          "value_mode": "absolute"
        }
      ]
    }
  ]
}
